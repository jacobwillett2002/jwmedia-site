---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import BackdropSection from '../components/BackdropSection.astro';
import SplitWords from '../components/SplitWords.astro';
import StartingAt from '../components/StartingAt.astro';
import heroBackdrop from '../assets/gallery/gal-sitd-02.jpg';

const allProjects = await getCollection('projects');
const musicProjects = allProjects
	.filter((p) => p.data.category === 'music' && !p.data.unlisted)
	.sort((a, b) => a.data.order - b.data.order);
---

<Layout
	title="Music Video Production San Diego & LA"
	description="San Diego and Los Angeles music video production and cinematography from JWMedia — including our San Diego Music Award for Best Music Video, for The Gravities' 'Stuck in the Desert.'"
>
	<ServiceSchema slot="head" name="Music Video Production" serviceType="Music video production" description="Music videos, promos and performance videos for artists and labels, directed and shot by JWMedia in San Diego and Los Angeles. Winner of Best Music Video at the 2026 San Diego Music Awards." price="music" />
	<BackdropSection image={heroBackdrop}>
		<div class="mx-auto max-w-7xl px-6 pb-12 pt-32 lg:px-10">
			<h1 class="text-sm font-semibold uppercase tracking-widest text-accent" data-reveal data-delay="100">San Diego Music Video Production</h1>
			<h2 class="mt-4 max-w-2xl font-display text-4xl tracking-wide text-fg sm:text-5xl" data-split aria-label="The Gravities get stuck in the desert — and win a San Diego Music Award for it." data-delay="200">
				<SplitWords text="The Gravities get stuck in the desert — and win a San Diego Music Award for it." />
			</h2>
			<p class="mt-4 max-w-2xl text-fg-muted" data-reveal data-delay="650">
				Award-winning <span class="gold-shimmer font-semibold">"Best Music Video"</span> at the San
				Diego Music Awards in May 2026. From full narrative music videos to live session coverage,
				this is where we live.
			</p>
			<a
				href="/stuck-in-the-desert"
				data-reveal
				data-delay="780"
				class="mt-4 inline-block text-sm font-semibold uppercase tracking-widest text-accent-gold hover:opacity-80"
			>
				Read the full story &rarr;
			</a>
			<StartingAt service="music" delay={900} note="Performance videos. Concept and multi-day campaigns scale from there." />
		</div>
	</BackdropSection>

	<section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				musicProjects.map((project) => (
					<ProjectCard
						title={project.data.title}
						tag={project.data.tag}
						thumbnail={project.data.thumbnail}
						thumbnailPosition={project.data.thumbnailPosition}
						thumbnailFit={project.data.thumbnailFit}
						thumbnailPool={project.data.thumbnailPool}
						artistLink={project.data.artistLink}
						caseStudyHref={project.data.caseStudyHref}
						videoProvider={project.data.videoProvider}
						videoId={project.data.videoId}
						previewStart={project.data.previewStart}
						slug={project.id}
						comingSoon={project.data.comingSoon}
						description={project.data.verifiedDescription ? project.data.description : undefined}
					/>
				))
			}
		</div>
	</section>

	<CtaBand
		heading="Got a track that needs visuals?"
		subheading="Tell us about the song and the story you want to tell — we'll take it from there."
	/>
</Layout>
