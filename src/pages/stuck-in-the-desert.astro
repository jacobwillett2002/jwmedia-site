---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import Lightbox from '../components/Lightbox.astro';
import SplitWords from '../components/SplitWords.astro';
import heroBackdrop from '../assets/gallery/hd-sitd-08.jpg';

const photoModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.jpg', {
	eager: true,
});

function resolve(filename: string): ImageMetadata {
	const mod = photoModules[`/src/assets/gallery/${filename}`];
	if (!mod) throw new Error(`Missing gallery image: ${filename}`);
	return mod.default;
}

const stills = [
	'hd-sitd-06.jpg',
	'hd-sitd-07.jpg',
	'hd-sitd-01.jpg',
	'hd-sitd-02.jpg',
	'hd-sitd-04.jpg',
	'hd-sitd-14.jpg',
	'sitd-money-01.jpg',
	'hd-sitd-09.jpg',
	'hd-sitd-10.jpg',
	'hd-sitd-11.jpg',
	'gal-sitd-01.jpg',
];

const facts = [
	{ label: 'Artist', value: 'The Gravities' },
	{ label: 'Written & Directed By', value: 'Jacob Willett' },
	{ label: 'Camera', value: 'RED V-Raptor, 8K' },
	{ label: 'Cinematography', value: 'Austin Harris', href: 'https://www.imdb.com/name/nm4491827/' },
	{ label: 'Location', value: 'Duck Camp, Imperial Valley, CA' },
	{ label: 'Shoot Length', value: 'One day' },
	{ label: 'Award', value: 'Best Music Video, San Diego Music Awards, May 2026' },
];
---

<Layout
	title="Stuck in the Desert — The Gravities"
	description="The story behind JWMedia's award-winning debut music video for The Gravities: written the night the song was first heard, shot in a single day at a family desert camp, and named Best Music Video at the 2026 San Diego Music Awards."
>
	<script
		type="application/ld+json"
		slot="head"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'VideoObject',
			name: 'Stuck in the Desert — The Gravities (Official Music Video)',
			description:
				'The Gravities’ music video "Stuck in the Desert," written and directed by Jacob Willett and produced by JWMedia. Winner of Best Music Video at the 2026 San Diego Music Awards.',
			thumbnailUrl: ['https://i.ytimg.com/vi/leWV_HcZ4kY/maxresdefault.jpg', 'https://i.ytimg.com/vi/leWV_HcZ4kY/hqdefault.jpg'],
			embedUrl: 'https://www.youtube.com/embed/leWV_HcZ4kY',
			url: 'https://jwmedia.biz/stuck-in-the-desert',
			award: 'Best Music Video, 2026 San Diego Music Awards',
			director: { '@type': 'Person', name: 'Jacob Willett' },
			creator: { '@id': 'https://jwmedia.biz/#organization' },
		})}
	/>
	<div class="read-progress" data-read-progress aria-hidden="true"></div>

	<section class="relative isolate flex min-h-[70vh] items-end overflow-hidden" data-parallax-hero>
		<div class="absolute inset-0 -z-10 overflow-hidden" data-parallax-media>
			<Image
				src={heroBackdrop}
				alt="The Gravities on location for Stuck in the Desert"
				class="h-full w-full object-cover"
				widths={[640, 1280, 1920, 2560]}
				sizes="100vw"
				priority
				data-settle
			/>
		</div>
		<div class="absolute inset-0 -z-10 bg-gradient-to-t from-bg via-bg/50 to-bg/10"></div>
		<div class="absolute inset-0 -z-10 bg-bg/35 lg:hidden"></div>
		<div class="mx-auto w-full max-w-7xl px-6 pb-16 pt-40 lg:px-10" data-parallax-content>
			<p class="text-sm font-semibold uppercase tracking-widest text-accent-gold" data-reveal data-delay="250">
				May 2026 · San Diego Music Awards — <span class="gold-shimmer">Best Music Video</span>
			</p>
			<h1
				class="mt-4 max-w-3xl font-display text-5xl leading-[1.05] tracking-wide text-fg sm:text-6xl lg:text-7xl"
				data-split
				aria-label="Stuck in the Desert"
				data-delay="400"
			>
				<SplitWords text="Stuck in the Desert" />
			</h1>
			<p class="mt-6 max-w-xl text-lg text-fg-muted" data-reveal data-delay="700">
				The Gravities, JWMedia's first official music video — and the first time Jacob Willett
				ever wrote and directed one.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-6 pt-16 lg:px-10" data-reveal>
		<div class="corners">
		<div class="aspect-video w-full overflow-hidden border border-border bg-bg-alt">
			<iframe
				class="h-full w-full"
				src="https://www.youtube.com/embed/leWV_HcZ4kY"
				title="Stuck in the Desert — The Gravities"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
				allowfullscreen
			></iframe>
		</div>
		</div>
		<p class="mt-5 text-sm text-fg-muted">
			Also at <a href="https://stuckinthedesert.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">stuckinthedesert.com</a> &middot; <a href="https://www.youtube.com/watch?v=d1QPMhQQvrA" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">Watch the live version, filmed at Wong's Golden Palace &rarr;</a>
		</p>
	</section>

	<section class="mx-auto max-w-5xl px-6 py-16 lg:px-10">
		<div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
			<div class="space-y-6 text-lg text-fg-muted">
				<p data-reveal>
					When a bank robbery gets botched, The Gravities have no choice but to destroy the money,
					or risk being killed. It's a cinematic, high-octane premise for JWMedia's first official
					music video — and it almost didn't happen the way anyone planned.
				</p>
				<p data-reveal>
					In July 2025, Jacob Willett set out to make filmmaking his focus — juggled
					alongside a full course load at SDSU — with no guarantee it would work out.
					A few weeks later, at the Black Star Polo Bene-Fest
					in mid-August, he reconnected with Jacob Clement,
					a childhood friend from elementary school who now runs No Corners Cut Productions
					alongside him and was there that day too, shooting BTS and photography for the bands.
					Together, the two Jacobs met The Gravities and the other San Diego Music Award-winning
					artists they still work with today. Founded by Sante Prince, <a href="https://blackstarpolo.org/" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">Black Star Polo</a> brings swimming and water polo
					to African and African-American communities that don't always have access to the pool —
					a cause that hit home for Jacob, who played water polo in high school.
				</p>
				<p data-reveal>
					Not long after, he went out to film a rehearsal with The Gravities for the Black Star
					Polo documentary he was producing.
					That's the first time he heard "Stuck in the Desert." He went home that night and wrote
					the treatment. He was still a film student at SDSU, and this was the first time he'd ever
					written and directed a music video.
				</p>
				<p data-reveal>
					The band shot it in a single day at the end of September, at Duck Camp — a family
					property out in the desert near Westmorland, California, next to a stretch of farmland
					in the Imperial Valley. Jacob's dad and grandfather built it from a dirt lot decades ago
					as a hunting campsite, and he spent a lot of time out there as a kid. It's an intimate
					place for him — they'd have "Smokey and the Bandit" running on a loop in the trailer,
					which is why it's playing on the TV in the film.
				</p>
				<p data-reveal>
					Behind the camera was Austin Harris, a cinematographer whose credits include drone and
					1st AC work on Hollywood features like Black Panther, Baby Driver, and Barbarian —
					brought on for this shoot, but the writing, direction, and production were entirely
					JWMedia's. The rest of the crew was mostly film students, and <a href="https://open.spotify.com/artist/1a7AFUqf2QbahEQtx6uuUt" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">Riston Diggs</a> — the San
					Diego hip-hop/rock-hop artist and two-time San Diego Music Award winner featured
					elsewhere on this site — plays one of the two on-screen robbers. Jacob's dad, Jeff
					Willett, and his lifelong best friend, Travis Trotter, pulled double duty: running gun,
					live-ammunition, fire, and boat safety on set, and playing the bodyguards facing the
					robbers down.
				</p>
				<p data-reveal>
					It was Jacob Clement's first time on a film set, too — his own leap of faith, taken
					alongside his childhood friend's. He handled behind-the-scenes and key photography
					throughout the shoot.
				</p>
				<p data-reveal>
					The video moves fast: Isaac and Riston blast wads of cash into the air with a
					clay-pigeon launcher at Duck Camp, cutting between performance and action shots at a
					junkyard and aboard a boat on the Salton Sea, before closing it out with Sam Triston
					Pierce playing guitar in front of the van as smoke pours from its engine — right
					before the gasoline trail ignites in slow motion for the final blaze. An announcer's
					voiceover introduces Sam Triston Pierce mid-song as "the
					biggest... the baddest guitar player in all the land" — the kind of over-the-top,
					not-taking-itself-too-seriously energy the whole video runs on.
				</p>
				<p data-reveal>
					"Stuck in the Desert" won Best Music Video at the 2026 San Diego Music Awards on May 6 at
					Humphreys Concerts by the Bay, two weeks before Jacob graduated.
				</p>
			</div>

			<div class="grid grid-cols-2 gap-6 content-start">
				{
					facts.map((fact) => (
						<div
							class="border border-border bg-bg-alt p-4 transition-colors duration-300 hover:border-accent-gold/40"
							data-reveal
						>
							<p class="text-xs uppercase tracking-wide text-fg-muted">{fact.label}</p>
							<p class="mt-1 font-display text-lg tracking-wide text-fg">{fact.value}</p>
							{fact.href && (
								<a
									href={fact.href}
									target="_blank"
									rel="noopener noreferrer"
									class="mt-1 inline-block text-xs font-medium text-accent hover:opacity-80"
								>
									View on IMDb &rarr;
								</a>
							)}
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-y border-border bg-bg-alt">
		<div class="mx-auto max-w-4xl px-6 py-16 lg:px-10">
			<div data-reveal>
				<p class="text-sm font-semibold uppercase tracking-widest text-accent-gold">The Underdog</p>
				<h2 class="mt-4 font-display text-3xl tracking-wide text-fg sm:text-4xl">
					A 150-listener band, up against label money.
				</h2>
			</div>
			<p class="mt-6 text-lg text-fg-muted" data-reveal>
				"Stuck in the Desert" was nominated for Best Music Video alongside <a href="https://open.spotify.com/artist/42FzVuyJH8YbkhzWSR2n8E" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">Almost Monday</a> (<a href="https://www.youtube.com/watch?v=nNYOk4y8RsA" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"enjoy the ride"</a>), <a href="https://open.spotify.com/artist/4VgJ0UD0zECXTaxPsEpbwk" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">Emilia Vaughn</a> (<a href="https://www.youtube.com/watch?v=Ff5LKfTa1Ik" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"Rock Music, Girl Secrets"</a>), <a href="https://open.spotify.com/artist/74WQEtTjMD1HpRnx6xDXpQ" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">Eric Sage</a> (<a href="https://www.youtube.com/watch?v=-6EO8RuSyjo" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"Rise Up San Diego"</a>), <a href="https://open.spotify.com/artist/2dzSec5CF9xQeW53ZJ5RHq" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">KBong</a> (<a href="https://www.youtube.com/watch?v=UUiBgIkKr_c" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"Good News"</a>), <a href="https://open.spotify.com/artist/3kulsLvu2CrpfHhc3tV5Jl" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">Cheyenne Benton</a> ("Lessons"), and <a href="https://open.spotify.com/artist/3gsBeIlFaBqLxT4LKdnuGH" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">Doah's Daydream</a> (<a href="https://www.youtube.com/watch?v=vlSWV8XjoQ0" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"Girls Girl"</a>).
				Almost Monday alone pulls in millions of monthly Spotify listeners, and Emilia
				Vaughn — a Berklee College of Music student with over 16,000 monthly Spotify listeners —
				brought the real numbers to beat: her "Rock Music, Girl Secrets" video has racked up 2.5
				million YouTube views, dwarfing the rest of the field. Eric Sage, for his part, is signed
				to Pacific Records, and "Rise Up San Diego" debuted as the San Diego Gulls' new anthem in
				a packed arena.
			</p>
			<p class="mt-4 text-lg text-fg-muted" data-reveal>
				<a href="https://open.spotify.com/artist/7rKZX2oH4IyUtw05LqWm30" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">The Gravities</a> went into that room with about 150 monthly listeners and JWMedia's first
				music video, written the night Jacob first heard the song. <span class="ink-underline text-fg">They won anyway.</span>
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-6 pb-24 pt-24 lg:px-10">
		<div data-reveal>
			<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">On Set</h2>
			<p class="mt-3 max-w-2xl text-fg-muted">
				Real stills from the one-day shoot at Duck Camp — click any image to view it full-size.
			</p>
		</div>
		<div class="mt-10 columns-1 gap-4 sm:columns-2 lg:columns-3">
			{
				stills.map((filename, i) => (
					<button
						type="button"
						class="gallery-item group relative mb-4 block w-full overflow-hidden border border-border"
						data-src={filename}
						data-reveal="img"
						data-caption="On Set"
					>
						<Image
							src={resolve(filename)}
							alt={`Stuck in the Desert — behind the scenes photo ${i + 1}`}
							widths={[400, 700, 1000]}
							sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
							class="w-full"
							loading="lazy"
						/>
					</button>
				))
			}
		</div>
	</section>

	<Lightbox />

	<CtaBand
		heading="Want a video that actually tells a story?"
		subheading="Send us the song, the release date, and the budget — we'll tell you what fits, and what doesn't."
	/>
</Layout>
