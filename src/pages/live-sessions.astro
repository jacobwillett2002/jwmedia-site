---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';

const allProjects = await getCollection('projects');
const liveProjects = allProjects
	.filter((p) => p.data.category === 'live')
	.sort((a, b) => a.data.order - b.data.order);
---

<Layout
	title="Live Concert & Event Videography San Diego"
	description="Multi-camera live concert and event videography in San Diego — full-set coverage at SOMA, Sessions by the Bay, and studio sessions from JWMedia."
>
	<section class="mx-auto max-w-7xl px-6 pb-12 pt-32 lg:px-10">
		<p class="text-sm font-semibold uppercase tracking-widest text-accent">Live Sessions</p>
		<h1 class="mt-4 max-w-2xl font-display text-4xl tracking-wide text-fg sm:text-5xl">
			Full sets, in the room, in 4K.
		</h1>
		<p class="mt-4 max-w-2xl text-fg-muted">
			Multi-camera coverage of live performances and in-studio sessions — from SOMA San Diego to
			Sessions by the Bay.
		</p>
	</section>

	<section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				liveProjects.map((project) => (
					<ProjectCard
						title={project.data.title}
						tag={project.data.tag}
						thumbnail={project.data.thumbnail}
						videoProvider={project.data.videoProvider}
						videoId={project.data.videoId}
						comingSoon={project.data.comingSoon}
					/>
				))
			}
		</div>
	</section>

	<CtaBand
		heading="Ready to get your visuals executed?"
		subheading="Multi-camera, full-song coverage for shows, sessions, and studio time."
	/>
</Layout>
