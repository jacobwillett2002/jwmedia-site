const photoModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.jpg', {
	eager: true,
});

function resolve(filename: string): ImageMetadata {
	const mod = photoModules[`/src/assets/gallery/${filename}`];
	if (!mod) throw new Error(`Missing gallery image: ${filename}`);
	return mod.default;
}

