---
// Search-engine details for a service page: what the service is, where it's offered, and the page's
// place in the site (breadcrumb).
interface Props {
	name: string;
	serviceType: string;
	description: string;
}

const { name, serviceType, description } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name,
		serviceType,
		description,
		url,
		provider: { '@id': 'https://jwmedia.biz/#organization' },
		areaServed: [
			{ '@type': 'City', name: 'San Diego' },
			{ '@type': 'City', name: 'Los Angeles' },
			{ '@type': 'State', name: 'California' },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jwmedia.biz/' },
			{ '@type': 'ListItem', position: 2, name, item: url },
		],
	},
];
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
