---
// Package ranges for a service page. Edit them in src/data/pricing.ts.
import { packages, type PricedService } from '../data/pricing';

interface Props {
	service: PricedService;
	heading?: string;
	note?: string;
}

const { service, heading = 'Packages', note = 'Every quote is built around your project. These are typical ranges, not a menu.' } = Astro.props;
const list = packages[service] ?? [];
---

{
	list.length > 0 && (
		<section class="mx-auto max-w-7xl px-6 pb-20 lg:px-10">
			<div data-reveal>
				<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">{heading}</h2>
				<p class="mt-3 max-w-2xl text-fg-muted">{note}</p>
			</div>
			<div class:list={['mt-8 grid gap-6', list.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3']}>
				{list.map((item, i) => (
					<div class="border border-border bg-bg-alt p-6" data-reveal data-delay={String(i * 90)}>
						<p class="text-xs font-semibold uppercase tracking-widest text-fg-muted">{item.name}</p>
						<p class="mt-2 font-display text-3xl tracking-wide text-accent-gold">{item.price}</p>
						<p class="mt-3 text-sm text-fg-muted">{item.detail}</p>
					</div>
				))}
			</div>
		</section>
	)
}
