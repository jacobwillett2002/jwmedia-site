---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactPrompt from '../components/ContactPrompt.astro';
import VideoModal from '../components/VideoModal.astro';
import { googleProfileUrl } from '../data/reviews';
import { startingPrices } from '../data/pricing';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Open Graph type, e.g. 'video.other' on a video's own page */
	ogType?: string;
}

const { title, description, image = '/og-image.jpg', ogType = 'website' } = Astro.props;

const siteName = 'JWMedia';
const fullTitle = `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const jsonLd = {
	'@context': 'https://schema.org',
	// ProfessionalService is schema.org's type for a local service business; video production is its field.
	'@type': 'ProfessionalService',
	additionalType: 'https://en.wikipedia.org/wiki/Video_production',
	'@id': 'https://jwmedia.biz/#organization',
	name: 'JWMedia',
	legalName: 'JWMedia, LLC',
	description:
		'San Diego and Los Angeles video production company specializing in music videos, narrative & documentary film, live event coverage, and corporate livestreaming.',
	url: 'https://jwmedia.biz',
	logo: imageURL.toString(),
	image: imageURL.toString(),
	email: 'jacob@jwmedia.biz',
	telephone: '+1-619-609-7557',
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'San Diego',
		addressRegion: 'CA',
		addressCountry: 'US',
	},
	areaServed: ['San Diego, CA', 'Los Angeles, CA'],
	priceRange: '$$$',
	founder: { '@type': 'Person', name: 'Jacob Willett', jobTitle: 'Director' },
	award: 'Best Music Video, 2026 San Diego Music Awards (The Gravities, "Stuck in the Desert")',
	knowsAbout: [
		'Music video production',
		'Music videography',
		'Cinematography',
		'Film production',
		'Short film production',
		'Documentary filmmaking',
		'Live concert videography',
		'Multi-camera live sessions',
		'Livestream production',
		'Conference video production',
		'Concert photography',
		'Color grading',
	],
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Video production services',
		itemListElement: [
			['Music video production', '/music-cinematography', startingPrices.music],
			['Live concert videography', '/live-sessions', startingPrices.live],
			['Conference video and livestream production', '/conference-video-production-san-diego', startingPrices.events],
			['Short film and documentary production', '/narrative-and-documentary', startingPrices.narrative],
			['Music and concert photography', '/photo-gallery', startingPrices.photo],
		].map(([name, path, from]) => ({
			'@type': 'Offer',
			itemOffered: { '@type': 'Service', name, url: `https://jwmedia.biz${path}` },
			...(from !== null && { priceSpecification: { '@type': 'PriceSpecification', minPrice: from, priceCurrency: 'USD' } }),
		})),
	},
	sameAs: [
		'https://www.instagram.com/jwmedia.biz/',
		'https://www.youtube.com/channel/UCVnhW-a6Mu7H3edWdgB6hXg',
		'https://www.facebook.com/jacob.willett.2025',
		'https://www.linkedin.com/in/jacob-willett-894b901aa/',
		...(googleProfileUrl ? [googleProfileUrl] : []),
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={imageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!-- Turn on entrance motion before first paint, unless the visitor prefers reduced motion.
		     If the motion script fails to load, the failsafe shows everything after 4s. -->
		<script is:inline>
			(function () {
				var d = document.documentElement;
				d.classList.add('js');
				if (
					window.matchMedia &&
					!window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
					'IntersectionObserver' in window
				) {
					d.classList.add('motion');
					setTimeout(function () {
						if (!window.__jwmMotion) d.classList.remove('motion');
					}, 4000);
				}
			})();
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<slot name="head" />
	</head>
	<body class="bg-bg text-fg font-sans antialiased">
		<div class="grain-overlay"></div>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<ContactPrompt />
		<VideoModal />
		<script>
			import '../scripts/motion.ts';
			import '../scripts/card-preview.ts';
			import { recordPage } from '../scripts/journey.ts';
			recordPage();
		</script>
	</body>
</html>
