	'gal-edge-02.jpg': { alt: 'On set for The Resinators — Edge Sheeran.', tag: 'EDGE SHEERAN', group: 'edge' },
	'gal-edge-03.jpg': { alt: 'On set for The Resinators — Edge Sheeran.', tag: 'EDGE SHEERAN', group: 'edge' },

	'gal-nakedi-01.jpg': { alt: 'On set for The Naked I corporate demo reel.', tag: 'THE NAKED I', group: 'nakedi' },
	'gal-nakedi-02.jpg': { alt: 'On set for The Naked I corporate demo reel.', tag: 'THE NAKED I', group: 'nakedi' },

	'gal-ragoo-01.jpg': { alt: 'On set for More Truth — Princess Ragoo.', tag: 'PRINCESS RAGOO', group: 'ragoo' },
	'gal-ragoo-02.jpg': { alt: 'On set for More Truth — Princess Ragoo.', tag: 'PRINCESS RAGOO', group: 'ragoo' },

	'gal-oside-01.jpg': { alt: "Hip-hop show at O'side Sports Bar & Grill.", tag: "O'SIDE SPORTS BAR", group: 'oside' },
	'gal-oside-02.jpg': { alt: "Hip-hop show at O'side Sports Bar & Grill.", tag: "O'SIDE SPORTS BAR", group: 'oside' },
