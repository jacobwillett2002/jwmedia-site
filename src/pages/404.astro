---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SplitWords from '../components/SplitWords.astro';
import floorStill from '../assets/gallery/sitd-money-01.jpg';

const headline = 'This one got left on the cutting room floor.';

const links = [
	{ href: '/music-cinematography', label: 'Music Cinematography' },
	{ href: '/narrative-and-documentary', label: 'Narrative & Documentary' },
	{ href: '/live-sessions', label: 'Live Sessions' },
	{ href: '/photo-gallery', label: 'Photo Gallery' },
];
---

<Layout
	title="Page Not Found"
	description="This page doesn't exist — head back to JWMedia's music videos, films, live sessions, and photography."
>
	<section class="relative isolate flex min-h-[80vh] items-center overflow-hidden">
		<div class="absolute inset-0 -z-10 overflow-hidden">
			<Image
				src={floorStill}
				alt=""
				class="h-full w-full object-cover opacity-60"
				widths={[828, 1280, 1920]}
				sizes="100vw"
				priority
				data-settle
			/>
		</div>
		<div class="absolute inset-0 -z-10 bg-gradient-to-t from-bg via-bg/70 to-bg/40"></div>
		<div class="absolute inset-0 -z-10 bg-gradient-to-r from-bg/85 via-bg/40 to-transparent"></div>

		<div class="mx-auto w-full max-w-7xl px-6 py-32 lg:px-10">
			<p class="text-sm font-semibold uppercase tracking-widest text-accent-gold" data-reveal data-delay="100">
				Scene 404 · Take 1
			</p>
			<h1
				class="mt-4 max-w-3xl font-display text-5xl leading-[1.05] tracking-wide text-fg sm:text-6xl lg:text-7xl"
				data-split
				aria-label={headline}
				data-delay="220"
			>
				<SplitWords text={headline} />
			</h1>
			<p class="mt-6 max-w-xl text-lg text-fg-muted" data-reveal data-delay="650">
				The page you're after doesn't exist — or it never made the final cut. The good footage
				is this way.
			</p>
			<div class="mt-8 flex flex-wrap gap-4" data-reveal data-delay="780">
				<a
					href="/"
					class="btn-sheen rounded-full bg-accent px-8 py-3 text-sm font-semibold uppercase tracking-wide text-bg transition-opacity hover:opacity-90"
				>
					Back to the Homepage
				</a>
				<a
					href="/contact"
					class="rounded-full border border-border px-8 py-3 text-sm font-semibold uppercase tracking-wide text-fg transition-colors hover:border-accent hover:text-accent"
				>
					Book a Shoot
				</a>
			</div>
			<ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2" data-reveal data-delay="900">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								class="nav-link text-xs font-semibold uppercase tracking-widest text-fg-muted transition-colors hover:text-accent"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
