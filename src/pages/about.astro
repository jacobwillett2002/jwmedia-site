---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import jacobWillettPhoto from '../assets/team/jacob-willett.jpg';
import jacobClementPhoto from '../assets/team/jacob-clement.jpg';

const team = [
	{
		name: 'Jacob Willett',
		role: 'Founder & Director',
		handle: '@jacobwillett_',
		href: 'https://www.instagram.com/jacobwillett_/',
		photo: jacobWillettPhoto,
		bio: "Jacob Willett is the founder and director behind JWMedia, and a recent San Diego State University film production graduate. His music video for The Gravities' \"Stuck in the Desert\" won Best Video at the 2026 San Diego Music Awards — two weeks before he graduated, built up alongside school productions and restaurant work. Jacob leads every project from first concept through final cut, working closely with artists and bands to turn their sound into something worth watching.",
	},
	{
		name: 'Jacob Clement',
		role: 'Photographer & Cinematographer',
		handle: '@nocornerscutphotography',
		href: 'https://www.instagram.com/nocornerscutphotography/',
		photo: jacobClementPhoto,
		bio: 'Jacob Clement shoots alongside Jacob Willett on many of JWMedia’s music videos and productions, in addition to leading photography for weddings, music, events, and video across San Diego as No Corners Cut Photography. A San Diego Music Award-winning photographer in his own right, he brings the same eye for detail to every JWMedia shoot — from live shows to studio sessions to behind-the-scenes coverage.',
	},
];

const pillars = [
	{
		title: 'Filmmaker-First',
		description:
			'Every project starts with intentional storytelling and strong visual composition — not just coverage, a point of view.',
	},
	{
		title: 'San Diego Rooted',
		description:
			'Built inside the San Diego music scene, working closely with artists, labels, and promoters who trust us with their sound.',
	},
	{
		title: 'Full-Scale, In-House',
		description:
			'From pre-production to social rollout, one team carries the project the whole way through — no hand-offs, no lost context.',
	},
];

const process = [
	{
		step: '01',
		title: 'Ideation',
		description: 'We translate your sound, brand, or story into a concrete visual concept.',
		items: ['Creative direction', 'Treatment & mood boards', 'Shot lists'],
	},
	{
		step: '02',
		title: 'Pre-Production',
		description: 'Logistics locked so the shoot day runs itself.',
		items: ['Locations & permits', 'Crew & equipment', 'Scheduling & budgets'],
	},
	{
		step: '03',
		title: 'Production',
		description: 'Fully crewed shoots on location or in-studio.',
		items: ['Cinematography', 'Direction', 'Live sound & photography'],
	},
	{
		step: '04',
		title: 'Post-Production',
		description: 'Edit, color, and sound design tuned for how the piece will actually be watched.',
		items: ['Editing & color grading', 'Sound design & mix', 'Platform-specific cuts'],
	},
	{
		step: '05',
		title: 'Rollout',
		description: 'Deliverables ready for release day, not just the final export.',
		items: ['Social & trailer cuts', 'Release-day assets', 'Promo support'],
	},
];
---

<Layout
	title="About Our San Diego Production Team"
	description="Meet JWMedia — a San Diego video production team of independent filmmakers, creative directors, cinematographers, and photographers behind our award-winning work."
>
	<section class="mx-auto max-w-7xl px-6 pb-12 pt-32 lg:px-10">
		<p class="text-sm font-semibold uppercase tracking-widest text-accent">About JWMedia</p>
		<h1 class="mt-4 max-w-3xl font-display text-4xl tracking-wide text-fg sm:text-5xl">
			A filmmaker-first production team, built in San Diego.
		</h1>
	</section>

	<section class="mx-auto max-w-4xl px-6 pb-20 lg:px-10">
		<div class="space-y-6 text-lg text-fg-muted">
			<p>
				JWMedia is a San Diego-based team of independent filmmakers, creative directors,
				cinematographers, and editors. Music videos are our specialty — including a San Diego Music
				Award for Best Video — but the same crew handles documentaries and short films, live event coverage,
				corporate livestreaming, and photography for artists, venues, and brands.
			</p>
			<p>
				What began as a solo exploration of the San Diego music scene has grown into a scalable
				production team, now operating as a registered LLC. We support artists, labels, and
				producers across multiple markets, taking a project from a first conversation all the way
				through to a social media rollout.
			</p>
			<p>
				At the core of everything is a filmmaker-first approach — intentional storytelling, strong
				visual composition, and a commitment to elevating the artists and scenes we work inside of,
				starting with San Diego.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
		<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">Meet the Team</h2>
		<p class="mt-3 max-w-2xl text-fg-muted">The two people behind every JWMedia production.</p>

		<div class="mt-12 grid gap-12 sm:grid-cols-2">
			{
				team.map((member) => (
					<div class="flex flex-col items-start gap-5 sm:flex-row">
						<Image
							src={member.photo}
							alt={member.name}
							width={128}
							height={128}
							class="h-28 w-28 shrink-0 rounded-full border border-border object-cover"
						/>
						<div>
							<h3 class="font-display text-2xl tracking-wide text-fg">{member.name}</h3>
							<p class="text-xs font-semibold uppercase tracking-widest text-accent">{member.role}</p>
							<p class="mt-3 text-sm text-fg-muted">{member.bio}</p>
							<a
								href={member.href}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-3 inline-block text-sm font-medium text-fg-muted hover:text-accent"
							>
								{member.handle}
							</a>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="border-y border-border bg-bg-alt">
		<div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
			<div class="grid gap-10 sm:grid-cols-3">
				{
					pillars.map((pillar) => (
						<div>
							<h2 class="font-display text-2xl tracking-wide text-fg">{pillar.title}</h2>
							<p class="mt-3 text-sm text-fg-muted">{pillar.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
		<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">How We Work</h2>
		<p class="mt-3 max-w-2xl text-fg-muted">
			We cover the entire production process in-house, from first idea to final delivery.
		</p>

		<div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
			{
				process.map((stage) => (
					<div>
						<p class="font-display text-4xl text-accent">{stage.step}</p>
						<h3 class="mt-2 text-lg font-semibold text-fg">{stage.title}</h3>
						<p class="mt-2 text-sm text-fg-muted">{stage.description}</p>
						<ul class="mt-4 space-y-1">
							{stage.items.map((item) => (
								<li class="text-xs uppercase tracking-wide text-fg-muted">{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<CtaBand />
</Layout>
