---
interface Props {
	heading?: string;
	subheading?: string;
}

const {
	heading = 'Ready to book your shoot?',
	subheading = "Send us the song, the release date, and the budget — we'll tell you what fits, and what doesn't.",
} = Astro.props;
---

<section class="relative border-y border-border bg-bg-alt">
	<div class="horizon-rule absolute inset-x-0 top-0"></div>
	<div
		class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-6 py-16 sm:flex-row sm:items-center sm:justify-between lg:px-10"
	>
		<div>
			<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">{heading}</h2>
			<p class="mt-2 max-w-xl text-fg-muted">{subheading}</p>
		</div>
		<a
			href="/contact"
			class="shrink-0 rounded-full bg-accent px-8 py-3 text-sm font-semibold uppercase tracking-wide text-bg transition-opacity hover:opacity-90"
		>
			Book a Shoot
		</a>
	</div>
</section>
