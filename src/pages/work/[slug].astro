---
// One page per video (/work/<project file name>), built from src/content/projects. Each page has
// the video as its main content plus the details Google uses to list it as a video in search.
// Add "uploadDate": "YYYY-MM-DD" to a project file to make it eligible for video results.
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { money, startingPrices } from '../../data/pricing';

type Project = CollectionEntry<'projects'>;

export async function getStaticPaths() {
	const playable = (await getCollection('projects')).filter(
		(p) => p.data.videoProvider === 'youtube' && p.data.videoId && !p.data.unlisted && !p.data.comingSoon,
	);
	return playable.map((project) => ({ params: { slug: project.id }, props: { project, playable } }));
}

const { project, playable } = Astro.props as { project: Project; playable: Project[] };
const data = project.data;
const videoId = data.videoId!;

const CATEGORIES = {
	music: { label: 'Music Cinematography', href: '/music-cinematography', service: 'Music video', price: startingPrices.music, ask: 'Planning a music video?' },
	narrative: { label: 'Narrative & Documentary', href: '/narrative-and-documentary', service: 'Narrative or documentary', price: startingPrices.narrative, ask: 'Have a film in the works?' },
	live: { label: 'Live Sessions', href: '/live-sessions', service: 'Live session or concert', price: startingPrices.live, ask: 'Got a set that needs cameras?' },
} as const;
const category = CATEGORIES[data.category];

const galleryImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.jpg', { eager: true });
const localThumb = data.thumbnail && !data.thumbnail.startsWith('http') ? galleryImages[`/src/assets/gallery/${data.thumbnail}`]?.default : undefined;
const remoteThumb = data.thumbnail?.startsWith('http') ? data.thumbnail : undefined;
const ytThumb = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
const socialImage = localThumb ? (await getImage({ src: localThumb, width: 1280, format: 'jpg' })).src : remoteThumb ?? ytThumb;
const absolute = (url: string) => new URL(url, Astro.site).toString();

const kind = data.tag.charAt(0) + data.tag.slice(1).toLowerCase();
const description = data.verifiedDescription ? data.description : `${data.title}, a ${kind.toLowerCase()} by JWMedia.`;
const metaDescription = description.length > 158 ? `${description.slice(0, 155).replace(/\s+\S*$/, '')}…` : description;
const pageUrl = absolute(`/work/${project.id}`);

const videoSchema = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: data.title,
	description,
	thumbnailUrl: [absolute(socialImage), `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`],
	embedUrl: `https://www.youtube.com/embed/${videoId}`,
	url: pageUrl,
	...(data.uploadDate && { uploadDate: data.uploadDate }),
	creator: { '@id': 'https://jwmedia.biz/#organization' },
	publisher: { '@id': 'https://jwmedia.biz/#organization' },
};
const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jwmedia.biz/' },
		{ '@type': 'ListItem', position: 2, name: category.label, item: absolute(category.href) },
		{ '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
	],
};

// More from the same kind of work, then featured work to fill out the row.
const related = [
	...playable.filter((p) => p.id !== project.id && p.data.category === data.category).sort((a, b) => a.data.order - b.data.order),
	...playable.filter((p) => p.id !== project.id && p.data.category !== data.category && p.data.featured),
]
	.filter((p, i, list) => list.indexOf(p) === i)
	.slice(0, 3);

const artistLinkLabel = data.artistLink?.includes('spotify.com')
	? 'Listen on Spotify'
	: data.artistLink?.includes('instagram.com')
		? 'Follow on Instagram'
		: 'Learn more';
---

<Layout title={`${data.title} (${kind})`} description={metaDescription} image={socialImage} ogType="video.other">
	<script type="application/ld+json" set:html={JSON.stringify([videoSchema, breadcrumb])} slot="head" />

	<section class="mx-auto max-w-6xl px-6 pb-16 pt-28 lg:px-10">
		<a href={category.href} class="text-sm font-medium text-fg-muted transition-colors hover:text-accent" data-reveal>
			&larr; {category.label}
		</a>
		<p class="mt-6 flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-accent" data-reveal data-delay="80">
			<span class="h-px w-6 bg-accent-gold"></span>
			{data.tag}
		</p>
		<h1 class="mt-3 max-w-4xl font-display text-4xl tracking-wide text-fg sm:text-5xl" data-reveal data-delay="140">{data.title}</h1>

		<div class="corners mt-10" data-reveal="fade" data-delay="200">
		<div class="watch-player relative aspect-video overflow-hidden border border-border bg-bg-alt" data-watch={videoId}>
			<button type="button" class="group absolute inset-0 block h-full w-full" aria-label={`Play ${data.title}`}>
				{
					localThumb ? (
						<Image src={localThumb} alt="" widths={[828, 1280, 1920]} sizes="(min-width: 1152px) 1088px, 100vw" class="h-full w-full object-cover" loading="eager" />
					) : (
						<img src={remoteThumb ?? ytThumb} alt="" class="h-full w-full object-cover" />
					)
				}
				<span class="absolute inset-0 bg-bg/30 transition-colors duration-300 group-hover:bg-bg/10"></span>
				<span class="absolute left-1/2 top-1/2 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-accent/90 text-bg shadow-lg shadow-black/40 transition-transform duration-500 ease-out group-hover:scale-110">
					<svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-8 w-8" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
				</span>
			</button>
		</div>
		</div>

		<div class="mt-12 grid gap-10 lg:grid-cols-[1fr_20rem]">
			<div data-reveal>
				<p class="max-w-2xl text-lg text-fg-muted">{description}</p>
				<div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
					{data.caseStudyHref && <a href={data.caseStudyHref} class="text-accent-gold hover:opacity-80">Read the full story &rarr;</a>}
					{data.artistLink && <a href={data.artistLink} target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">{artistLinkLabel} &rarr;</a>}
					<a href={`https://www.youtube.com/watch?v=${videoId}`} target="_blank" rel="noopener noreferrer" class="text-fg-muted hover:text-accent">Watch on YouTube &rarr;</a>
				</div>
			</div>
			<aside class="self-start border border-border bg-bg-alt p-6" data-reveal data-delay="120">
				<p class="font-display text-2xl tracking-wide text-fg">{category.ask}</p>
				{
					category.price !== null && (
						<p class="mt-2 text-sm text-fg-muted">
							Starting at <span class="font-semibold text-accent-gold">{money(category.price)}</span>
						</p>
					)
				}
				<a
					href={`/contact?service=${encodeURIComponent(category.service)}`}
					class="btn-sheen mt-5 inline-block rounded-full bg-accent px-6 py-3 text-sm font-semibold uppercase tracking-wide text-bg transition-opacity hover:opacity-90"
				>
					Start a project
				</a>
			</aside>
		</div>
	</section>

	{
		related.length > 0 && (
			<section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
				<h2 class="font-display text-3xl tracking-wide text-fg" data-reveal>More work</h2>
				<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{related.map((p) => (
						<ProjectCard
							title={p.data.title}
							tag={p.data.tag}
							thumbnail={p.data.thumbnail}
							thumbnailPosition={p.data.thumbnailPosition}
							thumbnailFit={p.data.thumbnailFit}
							thumbnailPool={p.data.thumbnailPool}
							posterBackdrop={p.data.posterBackdrop}
							artistLink={p.data.artistLink}
							caseStudyHref={p.data.caseStudyHref}
							videoProvider={p.data.videoProvider}
							videoId={p.data.videoId}
							previewStart={p.data.previewStart}
							slug={p.id}
							comingSoon={p.data.comingSoon}
							description={p.data.verifiedDescription ? p.data.description : undefined}
						/>
					))}
				</div>
			</section>
		)
	}

	<CtaBand />
</Layout>

<script>
	// Click to play: the YouTube player only loads when asked, so the page opens fast.
	document.querySelectorAll<HTMLElement>('[data-watch]').forEach((box) => {
		box.querySelector('button')?.addEventListener('click', () => {
			const frame = document.createElement('iframe');
			frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(box.dataset.watch ?? '')}?autoplay=1&rel=0&playsinline=1&modestbranding=1`;
			frame.title = document.title;
			frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			frame.allowFullscreen = true;
			frame.referrerPolicy = 'strict-origin-when-cross-origin';
			frame.className = 'absolute inset-0 h-full w-full';
			box.replaceChildren(frame);
		});
	});
</script>
