---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import heroBackdrop from '../assets/gallery/hd-sitd-08.jpg';

const photoModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.jpg', {
	eager: true,
});

function resolve(filename: string): ImageMetadata {
	const mod = photoModules[`/src/assets/gallery/${filename}`];
	if (!mod) throw new Error(`Missing gallery image: ${filename}`);
	return mod.default;
}

const stills = [
	'hd-sitd-06.jpg',
	'hd-sitd-07.jpg',
	'hd-sitd-01.jpg',
	'hd-sitd-02.jpg',
	'hd-sitd-04.jpg',
	'hd-sitd-14.jpg',
	'sitd-money-01.jpg',
	'hd-sitd-09.jpg',
	'hd-sitd-10.jpg',
	'hd-sitd-11.jpg',
	'gal-sitd-01.jpg',
];

const facts = [
	{ label: 'Artist', value: 'The Gravities' },
	{ label: 'Written & Directed By', value: 'Jacob Willett' },
	{ label: 'Camera', value: 'RED V-Raptor, 8K' },
	{ label: 'Cinematography', value: 'Austin Harris', href: 'https://www.imdb.com/name/nm4491827/' },
	{ label: 'Location', value: 'Duck Camp, Imperial Valley, CA' },
	{ label: 'Shoot Length', value: 'One day' },
	{ label: 'Award', value: 'Best Music Video, San Diego Music Awards, May 2026' },
];
---

<Layout
	title="Stuck in the Desert — The Gravities"
	description="The story behind JWMedia's award-winning debut music video for The Gravities: written the night the song was first heard, shot in a single day at a family desert camp, and named Best Music Video at the 2026 San Diego Music Awards."
>
	<section class="relative flex min-h-[70vh] items-end overflow-hidden">
		<Image
			src={heroBackdrop}
			alt="The Gravities on location for Stuck in the Desert"
			class="absolute inset-0 -z-10 h-full w-full object-cover"
			widths={[640, 1280, 1920, 2560]}
			sizes="100vw"
			priority
		/>
		<div class="absolute inset-0 -z-10 bg-gradient-to-t from-bg via-bg/50 to-bg/10"></div>
		<div class="mx-auto w-full max-w-7xl px-6 pb-16 pt-40 lg:px-10">
			<p class="text-sm font-semibold uppercase tracking-widest text-accent-gold">
				May 2026 · San Diego Music Awards — <span class="gold-shimmer">Best Music Video</span>
			</p>
			<h1 class="mt-4 max-w-3xl font-display text-5xl leading-[1.05] tracking-wide text-fg sm:text-6xl lg:text-7xl">
				Stuck in the Desert
			</h1>
			<p class="mt-6 max-w-xl text-lg text-fg-muted">
				The Gravities, JWMedia's first official music video — and the first time Jacob Willett
				ever wrote and directed one.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-6 pt-16 lg:px-10">
		<div class="aspect-video w-full overflow-hidden border border-border bg-bg-alt">
			<iframe
				class="h-full w-full"
				src="https://www.youtube.com/embed/leWV_HcZ4kY"
				title="Stuck in the Desert — The Gravities"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
				allowfullscreen
			></iframe>
		</div>
		<p class="mt-3 text-sm text-fg-muted">
			Also at <a href="https://stuckinthedesert.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">stuckinthedesert.com</a>
		</p>
	</section>

	<section class="mx-auto max-w-5xl px-6 py-16 lg:px-10">
		<div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
			<div class="space-y-6 text-lg text-fg-muted">
				<p>
					When a bank robbery gets botched, The Gravities have no choice but to destroy the money,
					or risk being killed. It's a cinematic, high-octane premise for a band's first official
					music video — and it almost didn't happen the way anyone planned.
				</p>
				<p>
					In July 2025, Jacob Willett left his full-time job as a busser at Water Grill — juggled
					alongside a full course load at SDSU — to chase filmmaking full-time. A leap of faith
					with no guarantee it would work out; he hasn't taken another job since. A few weeks
					later, at the Black Star Polo Bene-Fest in mid-August, he met The Gravities and a
					handful of other artists he still works with today — and reconnected with Jacob Clement,
					a childhood friend from elementary school who now runs No Corners Cut Productions
					alongside him. Founded by Sante Prince, Black Star Polo brings swimming and water polo
					to African and African-American communities that don't always have access to the pool —
					a cause that hit home for Jacob, who played water polo in high school.
				</p>
				<p>
					Not long after, he went out to film a rehearsal with The Gravities for the Black Star
					Polo documentary he was producing.
					That's the first time he heard "Stuck in the Desert." He went home that night and wrote
					the treatment. He was still a film student at SDSU, and this was the first time he'd ever
					written and directed a music video.
				</p>
				<p>
					The band shot it in a single day at the end of September, at Duck Camp — a family
					property out in the desert near Westmorland, California, next to a stretch of farmland
					in the Imperial Valley. Jacob's dad and grandfather built it from a dirt lot decades ago
					as a hunting campsite, and he spent a lot of time out there as a kid. It's an intimate
					place for him — they'd have "Smokey and the Bandit" running on a loop in the trailer,
					which is why it's playing on the TV in the film.
				</p>
				<p>
					Behind the camera was Austin Harris, a cinematographer whose credits include drone and
					1st AC work on Hollywood features like Black Panther, Baby Driver, and Barbarian —
					brought on for this shoot, but the writing, direction, and production were entirely
					JWMedia's. The rest of the crew was mostly film students, and Riston Diggs — the San
					Diego hip-hop/rock-hop artist and two-time San Diego Music Award winner featured
					elsewhere on this site — plays one of the two on-screen robbers. Jacob's dad, Jeff
					Willett, and his lifelong best friend, Travis Trotter, pulled double duty: running gun,
					live-ammunition, fire, and boat safety on set, and playing the bodyguards facing the
					robbers down.
				</p>
				<p>
					It was Jacob Clement's first time on a film set, too — his own leap of faith, taken
					alongside his childhood friend's. He handled behind-the-scenes and key photography
					throughout the shoot; both of them have since left their jobs behind to chase this
					full-time.
				</p>
				<p>
					The video moves fast: Isaac and Riston blast wads of cash into the air with a
					clay-pigeon launcher at Duck Camp, cutting between performance and action shots at a
					junkyard and aboard a boat on the Salton Sea, before closing it out with
					the full band performing on top of the van — right before the gasoline trail ignites
					in slow motion for the final blaze. An announcer's voiceover introduces Isaac mid-song as "the
					biggest... the baddest guitar player in all the land" — the kind of over-the-top,
					not-taking-itself-too-seriously energy the whole video runs on.
				</p>
				<p>
					"Stuck in the Desert" won Best Music Video at the 2026 San Diego Music Awards on May 6 at
					Humphreys Concerts by the Bay — two weeks before Jacob graduated, and less than a year
					after he walked away from a steady paycheck to bet on this instead.
				</p>
			</div>

			<div class="grid grid-cols-2 gap-6 content-start">
				{
					facts.map((fact) => (
						<div class="border border-border bg-bg-alt p-4">
							<p class="text-xs uppercase tracking-wide text-fg-muted">{fact.label}</p>
							<p class="mt-1 font-display text-lg tracking-wide text-fg">{fact.value}</p>
							{fact.href && (
								<a
									href={fact.href}
									target="_blank"
									rel="noopener noreferrer"
									class="mt-1 inline-block text-xs font-medium text-accent hover:opacity-80"
								>
									View on IMDb &rarr;
								</a>
							)}
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-y border-border bg-bg-alt">
		<div class="mx-auto max-w-4xl px-6 py-16 lg:px-10">
			<p class="text-sm font-semibold uppercase tracking-widest text-accent-gold">The Underdog</p>
			<h2 class="mt-4 font-display text-3xl tracking-wide text-fg sm:text-4xl">
				A 150-listener band, up against label money.
			</h2>
			<p class="mt-6 text-lg text-fg-muted">
				"Stuck in the Desert" was nominated for Best Music Video alongside Almost Monday
				(<a href="https://www.youtube.com/watch?v=nNYOk4y8RsA" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"enjoy the ride"</a>),
				Emilia Vaughn (<a href="https://www.youtube.com/watch?v=Ff5LKfTa1Ik" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"Rock Music, Girl Secrets"</a>),
				Eric Sage (<a href="https://www.youtube.com/watch?v=-6EO8RuSyjo" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"Rise Up San Diego"</a>),
				KBong (<a href="https://www.youtube.com/watch?v=UUiBgIkKr_c" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"Good News"</a>),
				Cheyenne Benton ("Lessons"), and Doah's Daydream
				(<a href="https://www.youtube.com/watch?v=vlSWV8XjoQ0" target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80">"Girls Girl"</a>).
				Almost Monday alone pulls in millions of monthly Spotify listeners, and Emilia
				Vaughn — a Berklee College of Music student with over 16,000 monthly Spotify listeners —
				brought the real numbers to beat: her "Rock Music, Girl Secrets" video has racked up 2.5
				million YouTube views, dwarfing the rest of the field. Eric Sage, for his part, is signed
				to Pacific Records, and "Rise Up San Diego" debuted as the San Diego Gulls' new anthem in
				a packed arena.
			</p>
			<p class="mt-4 text-lg text-fg-muted">
				The Gravities went into that room with about 150 monthly listeners and JWMedia's first
				music video, written the night Jacob first heard the song. They won anyway.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-6 pb-24 pt-24 lg:px-10">
		<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">On Set</h2>
		<p class="mt-3 max-w-2xl text-fg-muted">
			Real stills from the one-day shoot at Duck Camp — click any image to view it full-size.
		</p>
		<div class="mt-10 columns-1 gap-4 sm:columns-2 lg:columns-3">
			{
				stills.map((filename, i) => (
					<button
						type="button"
						class="gallery-item group relative mb-4 block w-full overflow-hidden border border-border"
						data-src={filename}
					>
						<Image
							src={resolve(filename)}
							alt={`Stuck in the Desert — behind the scenes photo ${i + 1}`}
							widths={[400, 700, 1000]}
							sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
							class="w-full transition-transform duration-500 group-hover:scale-105"
							loading="lazy"
						/>
					</button>
				))
			}
		</div>
	</section>

	<div
		id="lightbox"
		class="fixed inset-0 z-[60] hidden items-center justify-center bg-bg/95 p-6"
		role="dialog"
		aria-modal="true"
	>
		<button
			id="lightbox-close"
			type="button"
			aria-label="Close"
			class="absolute right-6 top-6 text-3xl text-fg hover:text-accent"
		>
			&times;
		</button>
		<button
			id="lightbox-prev"
			type="button"
			aria-label="Previous photo"
			class="absolute left-4 top-1/2 -translate-y-1/2 text-4xl text-fg hover:text-accent"
		>
			&#8249;
		</button>
		<img id="lightbox-image" src="" alt="" class="max-h-[85vh] max-w-full object-contain" />
		<button
			id="lightbox-next"
			type="button"
			aria-label="Next photo"
			class="absolute right-4 top-1/2 -translate-y-1/2 text-4xl text-fg hover:text-accent"
		>
			&#8250;
		</button>
	</div>

	<CtaBand
		heading="Want a video that actually tells a story?"
		subheading="Send us the song, the release date, and the budget — we'll tell you what fits, and what doesn't."
	/>
</Layout>

<script>
	const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-item'));
	const sources = items.map((item) => item.querySelector('img')?.src ?? '');

	const lightbox = document.getElementById('lightbox');
	const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
	const closeBtn = document.getElementById('lightbox-close');
	const prevBtn = document.getElementById('lightbox-prev');
	const nextBtn = document.getElementById('lightbox-next');

	let currentIndex = 0;

	function open(index: number) {
		currentIndex = index;
		lightboxImage.src = sources[currentIndex];
		lightbox?.classList.remove('hidden');
		lightbox?.classList.add('flex');
	}

	function close() {
		lightbox?.classList.add('hidden');
		lightbox?.classList.remove('flex');
	}

	function show(delta: number) {
		currentIndex = (currentIndex + delta + sources.length) % sources.length;
		lightboxImage.src = sources[currentIndex];
	}

	items.forEach((item, index) => {
		item.addEventListener('click', () => open(index));
	});

	closeBtn?.addEventListener('click', close);
	prevBtn?.addEventListener('click', () => show(-1));
	nextBtn?.addEventListener('click', () => show(1));
	lightbox?.addEventListener('click', (e) => {
		if (e.target === lightbox) close();
	});

	document.addEventListener('keydown', (e) => {
		if (lightbox?.classList.contains('hidden')) return;
		if (e.key === 'Escape') close();
		if (e.key === 'ArrowLeft') show(-1);
		if (e.key === 'ArrowRight') show(1);
	});
</script>
