---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import BackdropSection from '../components/BackdropSection.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import HeroReel, { type ReelSlide } from '../components/HeroReel.astro';
import { money, startingPrices } from '../data/pricing';
import SplitWords from '../components/SplitWords.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image } from 'astro:assets';

const tickerItems = [
	'San Diego Music Awards Winner',
	'Label-Ready Productions',
	'San Diego, California',
];
import aboutBg from '../assets/gallery/gal-sitd-01.jpg';
import reelFire from '../assets/gallery/sitd-night-fire-01.jpg';
import reelRaye from '../assets/gallery/raye-sundaze-08.jpg';
import reelLive from '../assets/gallery/live-band-02.jpg';
import reelDeficit from '../assets/gallery/more-hangups-02.jpg';
import reelDuo from '../assets/gallery/sitd-duo-guns-01.jpg';

// Hero reel: stills from our own films, crossfading with a slow drift.
// Reorder, swap, or add stills here (any image in src/assets/gallery works).
const reelSlides: ReelSlide[] = [
	{
		image: reelFire,
		alt: 'Lighting the gasoline trail on the set of Stuck in the Desert',
		title: 'Stuck in the Desert',
		position: '42% 60%',
		origin: '45% 65%',
	},
	{
		image: reelRaye,
		alt: 'A BMX rider in the air above a San Diego skatepark, from Raye Sundaze — Summertime',
		title: 'Raye Sundaze — Summertime',
		position: '32% 30%',
		origin: '30% 25%',
		kx: '1.5%',
	},
	{
		image: reelLive,
		alt: 'A drummer under red and blue stage light at the Black Star Polo Bene-Fest',
		title: 'Black Star Polo Bene-Fest',
		position: '62% 40%',
		origin: '60% 40%',
		kx: '-1.5%',
	},
	{
		image: reelDeficit,
		alt: 'A lone figure at a late-night bus stop, from the short film DEFICIT',
		title: 'DEFICIT',
		origin: '50% 55%',
	},
	{
		image: reelDuo,
		alt: 'Two robbers back to back with revolvers, from Stuck in the Desert',
		title: 'Stuck in the Desert',
		position: '50% 35%',
		origin: '50% 30%',
		ky: '-1%',
	},
];

// Optional: a real looping showreel instead of the stills. Export a short muted
// MP4 (H.264, 1080p, ~10–15s, a few MB), put it in /public, and set this to e.g.
// '/reel.mp4'. The stills stay as the poster and the fallback.
const reelVideo: string | undefined = undefined;

const allProjects = await getCollection('projects');
const featured = allProjects
	.filter((p) => p.data.featured && !p.data.unlisted)
	.sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);

// Rounds down to the nearest 5 so the stat stays true as projects are added,
// without needing a manual bump for every single new file.
const productionCount = Math.floor(allProjects.length / 5) * 5;

// Stills shown under each service on the home page (files in src/assets/gallery, all from
// JWMedia's own productions). Click any to view it full size.
const galleryStills = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.jpg', { eager: true });
const still = (file: string) => galleryStills[`/src/assets/gallery/${file}`].default;
const servicePhotos: Record<string, { files: string[]; aspect: string; link: string }> = {
	'Music Cinematography': { files: ['hd-sitd-05.jpg', 'hd-sitd-10.jpg', 'more-edge-06.jpg', 'raye-sundaze-01.jpg'], aspect: 'aspect-[4/5]', link: 'See the music videos' },
	'Live Sessions': { files: ['whiskey-girl-live-01.jpg', 'more-bsp25-04.jpg', 'whiskey-girl-live-05.jpg', 'live-band-05.jpg'], aspect: 'aspect-[4/5]', link: 'See the live sessions' },
	'Narrative & Documentary': { files: ['more-hangups-03.jpg', 'more-ourplace-07.jpg', 'more-warriors-06.jpg', 'more-hangups-09.jpg'], aspect: 'aspect-video', link: 'See the films' },
	Photography: { files: ['michelin-headshot-01.jpg', 'studio-01.jpg', 'more-bsp25-10.jpg', 'studio-11.jpg'], aspect: 'aspect-[4/5]', link: 'See the photo gallery' },
};

const services = [
	{
		title: 'Music Cinematography',
		description: 'Music videos, promos, and studio content built to move your sound. Our specialty.',
		href: '/music-cinematography',
		from: startingPrices.music,
	},
	{
		title: 'Narrative & Documentary',
		description: 'Short films and documentaries today, with feature-length work on the horizon.',
		href: '/narrative-and-documentary',
		from: startingPrices.narrative,
	},
	{
		title: 'Live Sessions',
		description: 'Multi-camera coverage of live sets and in-studio sessions, in 4K.',
		href: '/live-sessions',
		from: startingPrices.live,
	},
	{
		title: 'Podcasting',
		description: 'Full multi-camera podcast production — ATEM Mini ISO Pro switcher, three high-end cameras, ready to record.',
		href: '/contact?service=Podcast',
		from: startingPrices.podcast,
	},
	{
		title: 'Photography',
		description: 'Live show, studio, and event photography for artists and brands.',
		href: '/photo-gallery',
		from: startingPrices.photo,
	},
	{
		title: 'Livestreaming & Corporate',
		description: 'Multi-camera wireless livestream production for corporate events and conferences.',
		href: '/conference-video-production-san-diego',
		from: startingPrices.events,
	},
];

const stats = [
	{ label: '2026 San Diego Music Awards', value: 'Best Music Video' },
	{ label: 'Core Services', value: '6' },
	{ label: 'Productions & Counting', value: `${productionCount}+` },
	{ label: 'Based In', value: 'San Diego' },
];

const process = [
	{ step: '01', title: 'Concept', description: 'We build the idea around your sound and goals.' },
	{ step: '02', title: 'Production', description: 'On-location or in-studio, fully crewed shoots.' },
	{ step: '03', title: 'Post', description: 'Edit, color, and sound design tuned for every platform.' },
	{ step: '04', title: 'Rollout', description: 'Deliverables cut for release day and social.' },
];
---

<Layout
	title="San Diego & LA Video Production Company"
	description="JWMedia is a San Diego Music Award-winning video production company based in San Diego and working throughout Los Angeles, creating music videos, documentaries, live event coverage, and corporate livestreaming. Book a free consultation."
>
	<section class="relative isolate flex min-h-[90vh] items-end overflow-hidden" data-parallax-hero>
		<HeroReel slides={reelSlides} video={reelVideo} />
		<div class="absolute inset-0 -z-10 bg-gradient-to-t from-bg via-bg/60 to-bg/20"></div>
		<div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-bg/80 via-bg/30 to-transparent lg:block"></div>
		<div class="absolute inset-0 -z-10 bg-bg/35 lg:hidden"></div>

		<div
			class="mx-auto w-full max-w-7xl px-6 pb-20 pt-40 lg:px-10 xl:flex xl:items-end xl:justify-between xl:gap-12"
			data-parallax-content
		>
			<div class="min-w-0">
				<a
					href="/stuck-in-the-desert"
					data-reveal
					data-delay="80"
					class="inline-block text-sm font-semibold uppercase tracking-widest text-accent-gold hover:opacity-80"
				>
					May 2026 · San Diego Music Awards — Best Music Video, "Stuck in the Desert" &rarr;
				</a>
				<h1
					data-split
					aria-label="We make art with the people building San Diego's music scene."
					data-delay="180"
					class="mt-4 max-w-3xl font-display text-5xl leading-[1.05] tracking-wide text-fg sm:text-6xl lg:text-7xl"
				>
					<SplitWords text="We make art with the people building San Diego's music scene." />
				</h1>
				<p class="mt-6 max-w-xl text-lg text-fg-muted" data-reveal data-delay="650">
					Music videos are our specialty — the same crew also handles documentaries and short films,
					live event coverage, corporate livestreaming, and photography, based in San Diego and
					ready to travel for the right scene.
				</p>
				<div class="mt-8 flex flex-wrap gap-4" data-reveal data-delay="800">
					<a
						href="/contact"
						class="btn-sheen rounded-full bg-accent px-8 py-3 text-sm font-semibold uppercase tracking-wide text-bg transition-opacity hover:opacity-90"
					>
						Book a Shoot
					</a>
					<a
						href="/music-cinematography"
						class="rounded-full border border-border px-8 py-3 text-sm font-semibold uppercase tracking-wide text-fg transition-colors hover:border-accent hover:text-accent"
					>
						See Our Work
					</a>
				</div>
			</div>

			<div
				class="reel-ui w-72 shrink-0 self-start border border-fg/10 bg-bg/50 px-5 pb-3 pt-4 backdrop-blur-md"
				data-reveal="fade"
				data-delay="1100"
			>
				<div class="flex items-center justify-between">
					<p class="text-xs font-semibold uppercase tracking-widest text-fg-muted">
						Now Showing{
							!reelVideo && (
								<>
									&nbsp;<span class="text-fg/40">·</span>&nbsp;<span data-reel-index>01</span>&nbsp;/&nbsp;
									{String(reelSlides.length).padStart(2, '0')}
								</>
							)
						}
					</p>
					<button
						type="button"
						class="reel-pause -mr-1 p-1 text-fg-muted transition-colors hover:text-fg"
						aria-label={reelVideo ? 'Pause hero video' : 'Pause hero slideshow'}
						aria-pressed="false"
						data-reel-pause
						data-state="playing"
					>
						<svg class="reel-pause-icon h-3.5 w-3.5" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
							<rect x="2.5" y="1.5" width="3" height="11" rx="0.5"></rect>
							<rect x="8.5" y="1.5" width="3" height="11" rx="0.5"></rect>
						</svg>
						<svg class="reel-play-icon h-3.5 w-3.5" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
							<path d="M3.5 1.8v10.4L12 7z"></path>
						</svg>
					</button>
				</div>
				<p class="mt-2 font-display text-2xl tracking-wide text-fg" data-reel-title>
					{reelVideo ? 'JWMedia Showreel' : reelSlides[0].title}
				</p>
				<div class:list={['mt-3 flex gap-1.5', reelVideo && 'hidden']}>
					{
						reelSlides.map((slide, i) => (
							<button
								type="button"
								class="reel-dot"
								data-reel-dot={i}
								aria-label={`Show still ${i + 1} of ${reelSlides.length}: ${slide.title}`}
							>
								<span class="reel-dot-fill" />
							</button>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<MarqueeTicker items={tickerItems} />

	<BackdropSection image={aboutBg}>
		<div class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
		<div class="grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
			<div data-reveal>
				<p class="text-sm font-semibold uppercase tracking-widest text-accent">Who We Are</p>
				<h2 class="mt-4 font-display text-3xl tracking-wide text-fg sm:text-4xl">
					San Diego video production, in service of the scene.
				</h2>
				<p class="mt-6 text-fg-muted">
					JWMedia started out shooting documentaries and multi-camera live coverage of indie shows
					around San Diego. Music videos became the specialty from there — including a San Diego
					Music Award for Best Music Video in May 2026 with The Gravities'{' '}
					<a href="/stuck-in-the-desert" class="text-accent hover:opacity-80">"Stuck in the Desert."</a>{' '}
					The same crew still covers live events, documentaries and short films, corporate
					livestreaming, and photography for artists, venues, and brands across the city.
				</p>
				<p class="mt-4 text-fg-muted">
					We produce short films today, with feature-length work on the horizon. Whatever the
					format, one team carries the project from first concept to final delivery.
				</p>
				<a
					href="/about"
					class="mt-6 inline-block text-sm font-medium text-accent hover:opacity-80"
				>
					More about JWMedia &rarr;
				</a>
			</div>

			<div class="grid grid-cols-2 gap-6 content-start">
				{
					stats.map((stat, i) => (
						<div
							data-reveal
							class="border border-border bg-bg-alt p-5 transition-colors duration-300 hover:border-accent-gold/40"
						>
							<p class:list={['font-display text-3xl', i === 0 ? 'gold-shimmer' : 'text-accent']}>
								{/^\d/.test(stat.value) ? (
									<>
										<span class="sr-only">{stat.value}</span>
										<span aria-hidden="true" data-count>{stat.value}</span>
									</>
								) : (
									stat.value
								)}
							</p>
							<p class="mt-1 text-xs uppercase tracking-wide text-fg-muted">{stat.label}</p>
						</div>
					))
				}
			</div>
		</div>

		</div>
	</BackdropSection>

	<section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
		<div class="mb-10 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between" data-reveal>
			<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">Selected Work</h2>
			<a href="/music-cinematography" class="text-sm font-medium text-accent hover:opacity-80">
				View all projects &rarr;
			</a>
		</div>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				featured.map((project) => (
					<ProjectCard
						title={project.data.title}
						tag={project.data.tag}
						thumbnail={project.data.thumbnail}
						thumbnailPosition={project.data.thumbnailPosition}
						thumbnailFit={project.data.thumbnailFit}
						thumbnailPool={project.data.thumbnailPool}
						posterBackdrop={project.data.posterBackdrop}
						artistLink={project.data.artistLink}
						caseStudyHref={project.data.caseStudyHref}
						videoProvider={project.data.videoProvider}
						videoId={project.data.videoId}
						previewStart={project.data.previewStart}
						slug={project.id}
						comingSoon={project.data.comingSoon}
						description={project.data.verifiedDescription ? project.data.description : undefined}
					/>
				))
			}
		</div>
	</section>

	<Reviews />

	<section class="border-y border-border bg-bg-alt">
		<div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
			<div data-reveal>
				<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">What We Do</h2>
				<p class="mt-3 max-w-2xl text-fg-muted">
					Six services, one crew — music videos are the specialty, not the whole story.
				</p>
			</div>

			{
				services
					.filter((service) => servicePhotos[service.title])
					.map((service) => {
						const photos = servicePhotos[service.title];
						return (
							<div class="mt-14">
								<div class="mb-6 flex flex-wrap items-end justify-between gap-4 border-b border-border pb-5" data-reveal>
									<div>
										<h3 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">{service.title}</h3>
										<p class="mt-2 max-w-xl text-sm text-fg-muted">{service.description}</p>
									</div>
									<div class="flex flex-col items-start gap-1 sm:items-end">
										{service.from !== null && (
											<p class="text-xs font-semibold uppercase tracking-widest text-fg-muted">From <span class="text-accent-gold">{money(service.from)}</span></p>
										)}
										<a href={service.href} class="group text-xs font-semibold uppercase tracking-widest text-accent-gold transition-colors hover:text-fg">
											{photos.link}
											<span aria-hidden="true">&nbsp;&rarr;</span>
										</a>
									</div>
								</div>
								<div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
									{photos.files.map((file, i) => (
										<button
											type="button"
											class="gallery-item group relative block w-full overflow-hidden border border-border"
											data-caption={service.title}
											data-reveal="img"
											data-delay={String(i * 90)}
										>
											<Image
												src={still(file)}
												alt={`${service.title} — still ${i + 1}`}
												widths={[400, 700, 1000]}
												sizes="(min-width: 768px) 25vw, 50vw"
												class:list={['w-full object-cover', photos.aspect]}
												loading="lazy"
												decoding="async"
											/>
										</button>
									))}
								</div>
							</div>
						);
					})
			}

			<div class="mt-14 grid gap-8 border-t border-border pt-10 sm:grid-cols-2">
				{
					services
						.filter((service) => !servicePhotos[service.title])
						.map((service) => (
							<a href={service.href} class="group block" data-reveal>
								<h3 class="font-display text-2xl tracking-wide text-fg transition-colors group-hover:text-accent">
									{service.title}
									<span class="svc-arrow" aria-hidden="true">&rarr;</span>
								</h3>
								<p class="mt-3 text-sm text-fg-muted">{service.description}</p>
								{service.from !== null && (
									<p class="mt-3 text-xs font-semibold uppercase tracking-widest text-accent-gold">From {money(service.from)}</p>
								)}
							</a>
						))
				}
			</div>
		</div>
	</section>

	<Lightbox />

	<section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
		<div data-reveal>
			<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">Full-Scale, Start to Finish</h2>
			<p class="mt-3 max-w-2xl text-fg-muted">
				What began with a team of friends covering the San Diego music scene has grown into a full
				production team. We cover every stage in-house.
			</p>
		</div>
		<div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				process.map((item) => (
					<div data-reveal>
						<span class="mb-5 block h-px w-full bg-accent-gold/40" data-reveal="line" aria-hidden="true" />
						<p class="font-display text-4xl text-accent">{item.step}</p>
						<h3 class="mt-2 text-lg font-semibold text-fg">{item.title}</h3>
						<p class="mt-2 text-sm text-fg-muted">{item.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<CtaBand />
</Layout>
