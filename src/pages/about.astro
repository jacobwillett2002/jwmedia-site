---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import BackdropSection from '../components/BackdropSection.astro';
import jacobWillettPhoto from '../assets/team/jacob-willett.jpg';
import jacobClementPhoto from '../assets/team/jacob-clement.jpg';
import heroBackdrop from '../assets/gallery/sitd-bts-01.jpg';

const team = [
	{
		name: 'Jacob Willett',
		role: 'Founder & Director',
		email: 'jacob@jwmedia.biz',
		handle: '@jacobwillett_',
		href: 'https://www.instagram.com/jacobwillett_/',
		photo: jacobWillettPhoto,
		bio: [
			"Jacob Willett grew up in San Marcos, graduating from San Marcos High School after starting out at Discovery Elementary — where he first met a young Jacob Clement, before the two lost touch when Willett moved on to San Elijo Middle School. He played water polo from 6th grade all the way through high school. Film came later: a path he found closer to the 2020 lockdown and has chased ever since, giving him a sense of purpose he didn't know he was missing. Media came first, though — while studying film theory at Palomar College, he got his start at its student radio station, KKSM AM 1320, interviewing artists like Paul Cherry, Brad Stank, 79.5, and Ditch Days. The radio work is what bridged his love of music into filmmaking.",
			"He holds a Bachelor's in Television, Film & New Media from San Diego State University — emphasis in Film Production, minor in Digital & Social Media Studies — building on an Associate's Degree from Palomar College. In July 2025, while still carrying a full course load at SDSU, he left his job as a busser at Water Grill to chase filmmaking full-time, and hasn't taken another job since.",
			"The leap paid off: The Gravities' \"Stuck in the Desert,\" the first music video he ever wrote and directed, won Best Music Video at the San Diego Music Awards in May 2026, two weeks before he graduated. Beyond music videos, Jacob directs JWMedia's short films and documentaries — including 86'd, Our Place, and Hang-Ups — and serves as video lead and co-producer for Beach Break Sessions' multi-camera live coverage. He leads every project from first concept through final cut, working closely with artists and bands to turn their sound into something worth watching.",
		],
	},
	{
		name: 'Jacob Clement',
		role: 'Cinematographer, Editor & Producer',
		email: 'nocornerscutphotography@gmail.com',
		handle: '@nocornerscutphotography',
		href: 'https://www.instagram.com/nocornerscutphotography/',
		photo: jacobClementPhoto,
		bio: [
			"Jacob Clement is a cinematographer and co-producer for JWMedia, and a seven-year award-winning San Diego photographer with a Professional Certificate in Photography from UC San Diego Extension — his background is rooted in Lightroom and Photoshop, built largely shooting weddings. Editing and color grading in DaVinci Resolve Studio, JWMedia's edit suite, came more recently, as he's taken on a bigger role across Gravities and Resinators projects.",
			"He and Willett met as kids at Discovery Elementary School, reconnecting years later at the Black Star Polo Bene-Fest — the same show that led to \"Stuck in the Desert,\" where Clement handled behind-the-scenes and key photography. He's since gone camera-to-color on other Gravities and Resinators work: co-cinematographer on The Resinators' \"Edge Sheeran,\" and sole cinematographer, editor, and colorist on Raye Sundaze's music video. What started as a leap of faith alongside his childhood friend has turned into a full-time career for him too.",
			"He runs No Corners Cut Productions in partnership with JWMedia, and also leads weddings, portraits, and music photography solo as No Corners Cut Photography.",
		],
	},
];

const pillars = [
	{
		title: 'Filmmaker-First',
		description:
			'Every project starts with intentional storytelling and strong visual composition — not just coverage, a point of view.',
	},
	{
		title: 'San Diego Rooted, World Curious',
		description:
			"Built inside the San Diego music scene — with a real pull toward regional and international sounds, and an ear always open to the next scene worth chasing.",
	},
	{
		title: 'Full-Scale, In-House',
		description:
			'Multi-camera rigs, wireless livestream gear, and drone coverage — edited and color-graded entirely in DaVinci Resolve Studio, run by one crew pre-production through post, all in-house and local to San Diego.',
	},
	{
		title: 'Always Growing',
		description:
			"Always learning, always scaling up — and looking ahead to mentoring and teaching the next wave of San Diego filmmakers.",
	},
];

const process = [
	{
		step: '01',
		title: 'Ideation',
		description: 'We translate your sound, brand, or story into a concrete visual concept.',
		items: ['Creative direction', 'Treatment & mood boards', 'Shot lists'],
	},
	{
		step: '02',
		title: 'Pre-Production',
		description: 'Logistics locked so the shoot day runs itself.',
		items: ['Locations & permits', 'Crew & equipment', 'Scheduling & budgets'],
	},
	{
		step: '03',
		title: 'Production',
		description: 'Fully crewed shoots on location or in-studio.',
		items: ['Cinematography', 'Direction', 'Live sound & photography'],
	},
	{
		step: '04',
		title: 'Post-Production',
		description: 'Edit, color, and sound design tuned for how the piece will actually be watched.',
		items: ['Editing & color grading', 'Sound design & mix', 'Platform-specific cuts'],
	},
	{
		step: '05',
		title: 'Rollout',
		description: 'Deliverables ready for release day, not just the final export.',
		items: ['Social & trailer cuts', 'Release-day assets', 'Promo support'],
	},
];
---

<Layout
	title="About Our San Diego & LA Production Team"
	description="Meet JWMedia — a San Diego and Los Angeles video production team of independent filmmakers, creative directors, cinematographers, and photographers behind our award-winning work."
>
	<BackdropSection image={heroBackdrop}>
		<div class="mx-auto max-w-7xl px-6 pb-12 pt-32 lg:px-10">
			<p class="text-sm font-semibold uppercase tracking-widest text-accent">About JWMedia</p>
			<h1 class="mt-4 max-w-3xl font-display text-4xl tracking-wide text-fg sm:text-5xl">
				A filmmaker-first production team, built in San Diego — going wherever the music takes us.
			</h1>
		</div>
	</BackdropSection>

	<section class="mx-auto max-w-4xl px-6 pb-20 lg:px-10">
		<div class="space-y-6 text-lg text-fg-muted">
			<p>
				JWMedia is a San Diego-based team of independent filmmakers, creative directors,
				cinematographers, and editors. Music videos are our specialty — including a San Diego Music
				Award for Best Music Video in May 2026 with The Gravities'{' '}
				<a href="/stuck-in-the-desert" class="text-accent hover:opacity-80">"Stuck in the Desert"</a>{' '}
				— but the same crew handles documentaries and short films, live event coverage, corporate
				livestreaming, and photography for artists, venues, and brands.
			</p>
			<p>
				What began with a team of friends shooting documentaries and multi-camera live coverage of
				indie shows around San Diego has grown into a scalable production team, now operating as a
				registered LLC. We scope productions from a few thousand dollars to label-budget campaigns,
				travel where the project calls for it, and support artists, labels, and producers across
				multiple markets — from a first conversation all the way through rollout.
			</p>
			<p>
				At the core of everything is a filmmaker-first approach — intentional storytelling, strong
				visual composition, and a commitment to elevating the artists and scenes we work inside of.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-6 pb-24 lg:px-10">
		<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">Meet the Team</h2>
		<p class="mt-3 max-w-2xl text-fg-muted">
			Two independent filmmakers — JWMedia and No Corners Cut Productions — held to the same
			standard: honest scope, intentional shots, and a clean handoff every time.
		</p>

		<div class="mt-12 grid gap-12 sm:grid-cols-2">
			{
				team.map((member) => (
					<div class="flex flex-col items-start gap-5 sm:flex-row">
						<Image
							src={member.photo}
							alt={member.name}
							width={128}
							height={128}
							class="h-28 w-28 shrink-0 rounded-full border border-border object-cover"
						/>
						<div>
							<h3 class="font-display text-2xl tracking-wide text-fg">{member.name}</h3>
							<a href={`mailto:${member.email}`} class="text-sm text-fg-muted hover:text-accent">
								{member.email}
							</a>
							<p class="mt-1 text-xs font-semibold uppercase tracking-widest text-accent">{member.role}</p>
							<div class="mt-3 space-y-3 text-sm text-fg-muted">
								{member.bio.map((paragraph) => <p>{paragraph}</p>)}
							</div>
							<a
								href={member.href}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-3 inline-block text-sm font-medium text-fg-muted hover:text-accent"
							>
								{member.handle}
							</a>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="border-y border-border bg-bg-alt">
		<div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
			<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
				{
					pillars.map((pillar) => (
						<div>
							<h2 class="font-display text-2xl tracking-wide text-fg">{pillar.title}</h2>
							<p class="mt-3 text-sm text-fg-muted">{pillar.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
		<h2 class="font-display text-3xl tracking-wide text-fg sm:text-4xl">How We Work</h2>
		<p class="mt-3 max-w-2xl text-fg-muted">
			We cover the entire production process in-house, from first idea to final delivery.
		</p>

		<div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
			{
				process.map((stage) => (
					<div>
						<p class="font-display text-4xl text-accent">{stage.step}</p>
						<h3 class="mt-2 text-lg font-semibold text-fg">{stage.title}</h3>
						<p class="mt-2 text-sm text-fg-muted">{stage.description}</p>
						<ul class="mt-4 space-y-1">
							{stage.items.map((item) => (
								<li class="text-xs uppercase tracking-wide text-fg-muted">{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<CtaBand />
</Layout>
