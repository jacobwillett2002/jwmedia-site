	'studio-03.jpg': { alt: 'Two collaborators reviewing footage on a camera indoors.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-04.jpg': { alt: 'Man using a camera setup indoors.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-05.jpg': { alt: 'Person working in a music studio with headphones.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-06.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-07.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-08.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-09.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-10.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-11.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-12.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-13.jpg': { alt: 'Portrait during the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-14.jpg': { alt: 'Michelin, studio headshot.', tag: 'STUDIO SESSION', group: 'trackone' },
	'studio-15.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'gal-trackone-01.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },
	'gal-trackone-02.jpg': { alt: 'Behind the scenes at the TrackOne studio session.', tag: 'STUDIO SESSION', group: 'trackone' },

	'live-band-01.jpg': { alt: 'Live performance at Black Star Polo Bene-Fest.', tag: 'BLACK STAR POLO', group: 'bsp' },
	'live-band-02.jpg': { alt: 'Drummer performing live at Black Star Polo Bene-Fest.', tag: 'BLACK STAR POLO', group: 'bsp' },
	'live-band-03.jpg': { alt: 'Guitarist performing live at Black Star Polo Bene-Fest.', tag: 'BLACK STAR POLO', group: 'bsp' },
	'live-band-04.jpg': { alt: 'Guitarist performing live at Black Star Polo Bene-Fest.', tag: 'BLACK STAR POLO', group: 'bsp' },
	'live-band-05.jpg': { alt: 'Vocalist performing live at Black Star Polo Bene-Fest.', tag: 'BLACK STAR POLO', group: 'bsp' },
	'gal-bsp-01.jpg': { alt: 'Live music at Black Star Polo Bene-Fest.', tag: 'BLACK STAR POLO', group: 'bsp' },
	'gal-bsp-02.jpg': { alt: 'Live music at Black Star Polo Bene-Fest.', tag: 'BLACK STAR POLO', group: 'bsp' },
	'gal-bsp-03.jpg': { alt: 'Live music at Black Star Polo Bene-Fest.', tag: 'BLACK STAR POLO', group: 'bsp' },

